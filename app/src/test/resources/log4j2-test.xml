<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{ISO8601} %-5level %logger - %msg%n%throwable"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="de.triology.cas.services.CasCustomTemplateManagerConfiguration" level="INFO"/>
        <Root level="ERROR">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
